# Copy this file to .env and fill in your own values.
# The tools load it with dotenv (see utilities/directoryUtilities.js and
# utilities/resticUtilities.js, which look for ../../.env relative to the working
# directory - adjust the path if you run the scripts from elsewhere).

# Folder (relative to the process working directory) where the restic repository
# and the generated backup folders live.
BACKUPFOLDER=./backups

# PostgreSQL used for the database validation step
POSTGRES_DB_HOST=dbhome
POSTGRES_DB_DATABASE=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

# restic
RESTIC_PASSWORD=change-me-to-a-long-random-password
RESTIC_REPOSITORY=
RESTIC_REMOTE=

# Telegram notifications (optional - the tool logs a warning when it is unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
